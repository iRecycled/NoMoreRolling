  <!-- ===== Post-build: copy plugin DLL to BepInEx plugins folder ===== -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <PropertyGroup>
      <PluginOutputDir>c:\SteamLibrary\steamapps\common\Gamble With Your Friends\BepInEx\plugins\NoMoreRolling</PluginOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginOutputDir)" />
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(PluginOutputDir)"
      OverwriteReadOnlyFiles="true" />
    <Message Text="[NoMoreRolling] Deployed to $(PluginOutputDir)" Importance="high" />
  </Target>

</Project>
